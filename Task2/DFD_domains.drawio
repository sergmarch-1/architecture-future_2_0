      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="0GJ5d86G77W8uDS_SS_9-121" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Процесс 1.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;gt; Элементы данных 1: данные, поступающие в Data Lakehouse из различных доменов, например:&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;MED -&amp;nbsp;медицинские карты, истории болезни, исследования, клиентские данные, графики приемов&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;PHARMA -&amp;nbsp;лекарственные препараты, логистика, спрос, запасы&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;FIN -&amp;nbsp;счета, платежи, кредиты&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;ELECTR -&amp;nbsp;мед оборудование, логистика, телеметрия, логи&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;HR -&amp;nbsp;учет сотрудников, KPI, вакансии, оргструктура&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;INFRA -&amp;nbsp;&amp;nbsp;политики доступа, метаданные, пайплайны, системные данные&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;gt; Флоу:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Домен → Data Lakehouse (неструктурированные, неотформатированные данные)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-410" y="680" width="570" height="160" as="geometry" />
        </mxCell>
        <mxCell id="0GJ5d86G77W8uDS_SS_9-122" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Процесс 2.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;gt; Элементы данных 2: Отчеты&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;gt;Флоу: Сотрудник (домен)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;→ Data API → Data Lakehouse (golden layer)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;→ Data API → Сотрудник&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-399" y="870" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="0GJ5d86G77W8uDS_SS_9-123" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Процесс 3.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&amp;gt; Элементы данных 3: Сырые данные (bronze layer)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;gt;Флоу: ИИ сервис&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;→ Data Lakehouse&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;→ ИИ сервис&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
